# instalar.sh crea el .env solo, con contraseñas aleatorias. Si se hace a mano: copiar a .env
# (no se sube a git) y cambiar TODAS las contraseñas. Para generarlas:  openssl rand -hex 16
# (solo letras y números: los caracteres / + @ rompen las direcciones de conexión a la base de datos)

# Base de datos (TimescaleDB)
POSTGRES_DB=calidad_agua
POSTGRES_USER=agua_admin
POSTGRES_PASSWORD=cambiar_esto
CHIRPSTACK_DB_PASSWORD=cambiar_esto_tambien
WEB_DB_PASSWORD=cambiar_esto_tambien

# ChirpStack: secreto de los tokens de sesión (openssl rand -hex 32)
CHIRPSTACK_API_SECRET=cambiar_esto


# ChirpStack: contraseña del usuario admin (la pone provisionar la primera vez, en vez de admin/admin)
CHIRPSTACK_ADMIN_PASSWORD=cambiar_esto

# Alta automática en ChirpStack (docker compose run --rm provisionar)
# EUI del wAP LR8: en RouterOS  /iot lora print  (columna gateway-id). Si se deja vacío, se da de alta luego.
GATEWAY_EUI=
# Nodo LILYGO: DevEUI de 16 cifras hex y claves OTAA de 32 (openssl rand -hex 8 / openssl rand -hex 16)
NODO_DEV_EUI=cambiar_esto
NODO_JOIN_EUI=0000000000000000
NODO_APP_KEY=cambiar_esto
NODO_NWK_KEY=cambiar_esto
