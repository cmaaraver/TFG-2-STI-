# Copiar a .env (no se sube a git) y cambiar TODAS las contraseñas.
# Para generar contraseñas:  openssl rand -base64 24

# Base de datos (TimescaleDB)
POSTGRES_DB=calidad_agua
POSTGRES_USER=agua_admin
POSTGRES_PASSWORD=cambiar_esto
CHIRPSTACK_DB_PASSWORD=cambiar_esto_tambien
WEB_DB_PASSWORD=cambiar_esto_tambien

# ChirpStack: secreto de los tokens de sesión (openssl rand -base64 32)
CHIRPSTACK_API_SECRET=cambiar_esto

# DuckDNS (https://www.duckdns.org): solo el subdominio, sin ".duckdns.org"
DUCKDNS_DOMINIO=calidad-agua-viveros
DUCKDNS_TOKEN=pegar_aqui_el_token_de_duckdns
