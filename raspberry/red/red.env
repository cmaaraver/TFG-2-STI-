# Datos de la red del instituto (VLAN 500). Los leen configurar-red.sh, firewall.sh e instalar.sh.
# Si algún dato cambia, se cambia SOLO aquí (o se pasa como variable de entorno al ejecutar).
# El puerto del switch donde va la Raspberry entrega la VLAN 500 sin etiquetar (modo acceso):
# la Raspberry no sabe nada de VLANs, solo ve una red normal. TODO VERIFICAR con el coordinador TIC.
IF_RED="${IF_RED:-eth0}"                    # puerto Ethernet integrado de la Raspberry
IP_RASPBERRY="${IP_RASPBERRY:-172.16.50.3}" # IP fija de la Raspberry
PREFIJO="${PREFIJO:-24}"                    # máscara 255.255.255.0 (TODO VERIFICAR con el TIC)
PUERTA_ENLACE="${PUERTA_ENLACE:-172.16.50.1}"
DNS="${DNS:-172.16.50.1}"                   # TODO VERIFICAR: si el TIC da otro DNS, ponerlo aquí (separados por comas)
IP_WAP="${IP_WAP:-172.16.50.2}"             # IP fija del gateway LoRa MikroTik wAP LR8
