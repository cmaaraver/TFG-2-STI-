# Proxy delante de la web. Solo HTTP en el puerto 80:
# - dentro del instituto: http://172.16.50.3
# - desde Internet: Tailscale Funnel pone el HTTPS y reenvía aquí (https://rpi-lora.<red>.ts.net)

:80 {
	encode gzip
	reverse_proxy web:8000 {
		flush_interval -1   # tiempo real: no retener los eventos SSE
	}
}
